{
  "name": "datagate-monitor-frontend-vite",
  "private": true,
  "version": "1.4.65",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK_API=1 vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.all=true --coverage.include=src/**/*.{ts,tsx} --coverage.exclude=src/api/orval/** --coverage.exclude=src/**/*.test.* --coverage.exclude=src/test/** --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "gen:api": "orval --config orval.config.ts",
    "gen:api:offline": "OPENAPI_URL=./openapi/swagger.json orval --config orval.config.ts",
    "orval": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@microsoft/signalr": "^10.0.11",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "axios": "^1.20.0",
    "js-cookie": "^3.0.8",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-globe.gl": "^2.38.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.18.3",
    "react-toastify": "^11.1.0",
    "recharts": "^3.10.1",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "overrides": {
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/js-cookie": "^3.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.9.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "orval": "^8.33.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
